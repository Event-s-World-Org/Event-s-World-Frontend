  "components": {
    "schemas": {
      "Money": {
        "type": "object",
        "required": [
          "amount",
          "currency"
        ],
        "description": "Amount as a string with two decimals plus an ISO 4217 code (NFR-05.2). Never a floating-point number.",
        "properties": {
          "amount": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$",
            "example": "120.00"
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3,
            "example": "BOB"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "description": "RFC 9457 error with a stable `code` such as `registrations.capacity_full`.",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "example": "registrations.capacity_full"
          },
          "correlationId": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "Me": {
        "type": "object",
        "required": [
          "id",
          "email",
          "firstNames",
          "lastNames",
          "globalRole",
          "status",
          "emailVerified",
          "hasEvents"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "firstNames": {
            "type": "string"
          },
          "lastNames": {
            "type": "string"
          },
          "globalRole": {
            "type": "string",
            "enum": [
              "user",
              "super_admin"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "suspended"
            ]
          },
          "emailVerified": {
            "type": "boolean"
          },
          "hasEvents": {
            "type": "boolean"
          }
        }
      },
      "MyEventSummary": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "title",
          "status",
          "startsAt",
          "timeZone",
          "capacity",
          "registrations",
          "pendingVouchers"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published",
              "registrations_closed",
              "finished",
              "suspended",
              "cancelled"
            ]
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "timeZone": {
            "type": "string",
            "example": "America/La_Paz"
          },
          "capacity": {
            "type": "integer"
          },
          "registrations": {
            "type": "integer"
          },
          "pendingVouchers": {
            "type": "integer"
          },
          "coverUrl": {
            "type": "string"
          },
          "qrExpiringSoon": {
            "type": "boolean"
          },
          "qrExpired": {
            "type": "boolean"
          }
        }
      },
      "PublicEventSummary": {
        "type": "object",
        "required": [
          "slug",
          "title",
          "startsAt",
          "timeZone",
          "city",
          "isFree"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "timeZone": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "isFree": {
            "type": "boolean"
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          },
          "coverUrl": {
            "type": "string"
          },
          "registrationState": {
            "type": "string",
            "enum": [
              "open",
              "full",
              "closed",
              "paused",
              "finished"
            ]
          }
        }
      },
      "PublicEventPage": {
        "type": "object",
        "required": [
          "items",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicEventSummary"
            }
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "PublicEvent": {
        "type": "object",
        "required": [
          "slug",
          "title",
          "description",
          "startsAt",
          "endsAt",
          "timeZone",
          "country",
          "city",
          "venue",
          "isFree",
          "spotsLeft",
          "registrationState",
          "organizerContact"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "coverUrl": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "registrationDeadline": {
            "type": "string",
            "format": "date-time"
          },
          "timeZone": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "venue": {
            "type": "string"
          },
          "mapUrl": {
            "type": "string"
          },
          "isFree": {
            "type": "boolean"
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          },
          "spotsLeft": {
            "type": "integer"
          },
          "registrationState": {
            "type": "string",
            "enum": [
              "open",
              "full",
              "closed",
              "paused",
              "finished"
            ]
          },
          "organizerContact": {
            "type": "string"
          },
          "minimumAge": {
            "type": "integer"
          }
        }
      },
      "CreateEvent": {
        "type": "object",
        "required": [
          "title"
        ],
        "description": "A draft accepts missing fields; completeness is checked when publishing (US-006). The slug is generated by the backend.",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "country": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "venue": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "registrationDeadline": {
            "type": "string",
            "format": "date-time"
          },
          "capacity": {
            "type": "integer",
            "minimum": 1
          },
          "organizerContact": {
            "type": "string"
          },
          "minimumAge": {
            "type": "integer"
          }
        }
      },
      "Event": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "title",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published",
              "registrations_closed",
              "finished",
              "suspended",
              "cancelled"
            ]
          },
          "description": {
            "type": "string"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "country": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "venue": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "registrationDeadline": {
            "type": "string",
            "format": "date-time"
          },
          "capacity": {
            "type": "integer"
          },
          "organizerContact": {
            "type": "string"
          },
          "minimumAge": {
            "type": "integer"
          },
          "isFree": {
            "type": "boolean"
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          },
          "publicUrl": {
            "type": "string"
          }
        }
      },
      "PaymentSubmission": {
        "type": "object",
        "required": [
          "id",
          "registrationId",
          "registrationCode",
          "participantName",
          "status",
          "isResubmission",
          "expectedAmount",
          "submittedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "registrationId": {
            "type": "string",
            "format": "uuid"
          },
          "registrationCode": {
            "type": "string",
            "example": "EW-7F3K2"
          },
          "participantName": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_observation",
              "approved",
              "rejected"
            ]
          },
          "isResubmission": {
            "type": "boolean"
          },
          "expectedAmount": {
            "$ref": "#/components/schemas/Money"
          },
          "isOpenAmountQr": {
            "type": "boolean"
          },
          "voucherUrl": {
            "type": "string"
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "InPersonRegistration": {
        "type": "object",
        "required": [
          "answers"
        ],
        "properties": {
          "answers": {
            "type": "object",
            "additionalProperties": true,
            "description": "Answers keyed by form field key; must include the email."
          },
          "method": {
            "type": "string",
            "enum": [
              "qr",
              "cash"
            ],
            "description": "Omitted for free events."
          },
          "cashReceived": {
            "$ref": "#/components/schemas/Money"
          }
        }
      },
      "RegistrationReceipt": {
        "type": "object",
        "required": [
          "registrationId",
          "code",
          "status"
        ],
        "properties": {
          "registrationId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "example": "EW-7F3K2"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_observation",
              "approved",
              "rejected",
              "confirmed"
            ]
          },
          "emailHasOtherRegistrations": {
            "type": "boolean"
          }
        }
      },
      "ExchangeToken": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "Personal-link token from the email (FR-05.1)."
          }
        }
      },
      "ParticipantSession": {
        "type": "object",
        "required": [
          "accessToken",
          "expiresAt"
        ],
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ParticipantRegistration": {
        "type": "object",
        "required": [
          "registrationId",
          "code",
          "status",
          "eventTitle",
          "eventStartsAt",
          "timeZone",
          "answers",
          "submissions"
        ],
        "properties": {
          "registrationId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_observation",
              "approved",
              "rejected",
              "confirmed"
            ]
          },
          "eventTitle": {
            "type": "string"
          },
          "eventStartsAt": {
            "type": "string",
            "format": "date-time"
          },
          "timeZone": {
            "type": "string"
          },
          "organizerContact": {
            "type": "string"
          },
          "answers": {
            "type": "object",
            "additionalProperties": true
          },
          "submissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaymentSubmission"
            }
          },
          "canResubmit": {
            "type": "boolean"
          }
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "RFC 9457 problem details",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "supabase": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "participant": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
